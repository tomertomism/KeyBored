		col_15 { gpios = <&gpio1  8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>; };

		// col_0  { gpios = <&gpio0  8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
		// col_1  { gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
		// col_2  { gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
